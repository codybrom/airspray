# Per-user Xcode state, wherever the project lives. (A pattern with a slash in
# the middle, like "*.xcodeproj/xcuserdata/", only matches at the repo root.)
xcuserdata/
*.xcuserstate
# Xcode recreates the workspace embedded in a project whenever it opens it.
**/*.xcodeproj/project.xcworkspace/
.build/
*.dSYM/
*.swiftdoc
*.swiftmodule
*Binary

